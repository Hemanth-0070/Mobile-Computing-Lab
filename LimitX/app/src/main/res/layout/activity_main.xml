<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0D1117"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="LimitX Dashboard"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#58A6FF"
        android:layout_marginBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <Button android:id="@+id/btnUsage" android:text="App Usage" style="@style/btnStyle"/>
    <Button android:id="@+id/btnFocus" android:text="Focus Mode" style="@style/btnStyle"/>
    <Button android:id="@+id/btnStats" android:text="Statistics" style="@style/btnStyle"/>
    <Button android:id="@+id/btnSettings" android:text="Settings" style="@style/btnStyle"/>
    <Button android:id="@+id/btnHelp" android:text="Help" style="@style/btnStyle"/>
    <Button android:id="@+id/btnAbout" android:text="About" style="@style/btnStyle"/>

</LinearLayout>