<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hemanth.limitx">

    <application
        android:allowBackup="true"
        android:label="LimitX"
        android:supportsRtl="true"
        android:theme="@style/Theme.LimitX">

        <!-- MAIN ACTIVITY -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- USAGE -->
        <activity android:name=".UsageActivity" android:exported="false"/>

        <!-- FOCUS -->
        <activity android:name=".FocusActivity" android:exported="false"/>

        <!-- BLOCK SCREEN -->
        <activity
            android:name=".BlockActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar"/>

        <!-- STATS -->
        <activity android:name=".StatsActivity" android:exported="false"/>

        <!-- SETTINGS -->
        <activity android:name=".SettingsActivity" android:exported="false"/>

        <!-- HELP -->
        <activity android:name=".HelpActivity" android:exported="false"/>

        <!-- ABOUT -->
        <activity android:name=".AboutActivity" android:exported="false"/>

        <!-- ACCESSIBILITY SERVICE -->
        <service
            android:name=".AppAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">

            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>

    </application>

</manifest>